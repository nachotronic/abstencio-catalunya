<script>
jQuery(function ($) {

  /* use touchstart on phones / tablets, click on desktop */
  var tapEvent = ('ontouchstart' in window) ? 'touchstart' : 'click';

  /* ---------- MOBILE OFF-CANVAS PANEL (#navbar-header) ---------- */

  $('#navbar-header').on(tapEvent,
    '.dropdown-menu-container, .dropdownArea, .dropdownArrow',
    function (e) {

      var $li      = $(this).closest('.dropdown-menu'),
          $submenu = $li.children('.dropdown-menu-submenu'),
          hasSub   = $submenu.length;

      /* plain items (no submenu) → let them navigate straight away */
      if (!hasSub) { return; }

      /* if submenu is CLOSED → open it & block navigation            *
       * if submenu is OPEN   → allow navigation on the 2nd tap       */
      var isOpen = $submenu.hasClass('dropdown_active');
      if (!isOpen) {
        e.preventDefault();      // block link ONLY the first time
      }

      /* close others, then toggle this one */
      $('#navbar-header .dropdown-menu-submenu.dropdown_active')
          .not($submenu)
          .removeClass('dropdown_active')
          .siblings('.dropdown-menu-container')
          .find('.dropdownArrow').removeClass('dropdownArrow_active');

      $submenu.toggleClass('dropdown_active', !isOpen);
      $li.find('.dropdownArrow').first()
          .toggleClass('dropdownArrow_active', !isOpen);
  });

  /* close everything when tapping outside the grey panel */
  $(document).on(tapEvent, function (e) {
    if (!$(e.target).closest('.dropdown_panel').length) {
      $('#navbar-header .dropdown-menu-submenu.dropdown_active')
          .removeClass('dropdown_active');
      $('#navbar-header .dropdownArrow.dropdownArrow_active')
          .removeClass('dropdownArrow_active');
    }
  });

  /* ---------- TOP DESKTOP BAR (#m1) stays hover-only ---------- */
});
