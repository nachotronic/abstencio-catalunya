<script>
(function() {
  // ====== CONFIGURACIÓN ======
  const SHOW_DELAY_MS = 1500;
  const STORAGE_DISMISS_KEY = 'maldita_popup_dismissed';
  const EXCLUDED_PATHS = ['/apoya-investigacion'];
  // ============================

  const path = window.location.pathname;
  if (EXCLUDED_PATHS.some(p => path === p || path.startsWith(p + '/'))) return;

  if (window.MALDITA_USER && window.MALDITA_USER.isDonor === true) return;

  try {
    if (localStorage.getItem(STORAGE_DISMISS_KEY) === '1') return;
  } catch (e) {}

  const overlay = document.getElementById('maldita-popup-overlay');
  const closeBtn = document.getElementById('maldita-popup-close');
  if (!overlay) return;

  let lastFocused = null;

  function open() {
    lastFocused = document.activeElement;
    overlay.classList.add('active');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.classList.add('maldita-popup-open');
    setTimeout(() => closeBtn && closeBtn.focus(), 100);
  }

  function close() {
    overlay.classList.remove('active');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('maldita-popup-open');
    try { localStorage.setItem(STORAGE_DISMISS_KEY, '1'); } catch (e) {}
    if (lastFocused && lastFocused.focus) lastFocused.focus();
  }

  closeBtn && closeBtn.addEventListener('click', close);
  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) close();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && overlay.classList.contains('active')) close();
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => setTimeout(open, SHOW_DELAY_MS));
  } else {
    setTimeout(open, SHOW_DELAY_MS);
  }
})();
</script>
